# App
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10
REFERENCE_WIDTH_CM=180

# Auth / rate limiting
# Leave empty to allow anonymous access (10 req/hour by default)
API_KEY=
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_WITH_KEY_PER_HOUR=1000

# Detector: auto | yolo | opencv | huggingface | roboflow
DETECTOR_BACKEND=auto
MODEL_PATH=models/car_damage_yolov8.pt
CONFIDENCE_THRESHOLD=0.25

# HuggingFace Inference API (optional — Variant C)
HF_API_TOKEN=
HF_MODEL_ID=facebook/detr-resnet-50
HF_API_URL=https://api-inference.huggingface.co/models

# Roboflow hosted model (optional — Variant A)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_VERSION=1
ROBOFLOW_API_URL=https://detect.roboflow.com
